# Pass these variables to the Node service environment. Never use a VITE_ key.
ECOLOGY_MODE=rule
# ECOLOGY_MODE=model
# ARK_API_KEY=your-private-server-key
ECOLOGY_MODEL=deepseek-v4-flash
ECOLOGY_FALLBACK_MODEL=doubao-seed-2.0-lite
# Both models use provider-default reasoning; no reasoning_effort is sent.
# Set ECOLOGY_FALLBACK_MODEL=off to disable model fallback.
ARK_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ECOLOGY_HOST=127.0.0.1
ECOLOGY_PORT=5197
